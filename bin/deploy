#!/bin/sh

set -e

ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
APP_NAME=${HEROKU_APP_NAME:-story-maker-piper}

. "$ROOT_DIR/bin/common"

case ${1-} in
	-h|--help)
		show_script_help \
			'bin/deploy' \
			'Build and release the Piper container to Heroku Container Registry. Set HEROKU_APP_NAME to target a different app.'
		exit 0
		;;
esac

cd "$ROOT_DIR"

if [ ! -f ./main.py ]; then
	printf '%s\n' 'Error: Missing source code (expected ./main.py)' >&2
	exit 1
fi

printf '%s\n' ">>>> Authenticating in Heroku Container Registry for $APP_NAME..."
heroku container:login
printf '%s\n' 'Authenticated!'

printf '%s\n' ">>>> Starting container build for $APP_NAME..."
heroku container:push web --app "$APP_NAME"
printf '%s\n' 'Build complete!'

printf '%s\n' ">>>> Releasing new version for $APP_NAME..."
heroku container:release web --app "$APP_NAME"
printf '%s\n' 'Done'

heroku open --app "$APP_NAME" || true