#!/bin/sh

set -e

ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$ROOT_DIR/bin/common"
QUIET=0

while [ $# -gt 0 ]; do
    case $1 in
        -h|--help)
            show_script_help \
                'bin/env' \
                ' [OPTIONS]' \
                'Create or update the local Python virtual environment and install requirements.'
            printf '%s\n' '  -q, --quiet  Suppress the completion message'
            exit 0
            ;;
        -q|--quiet)
            QUIET=1
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            exit 1
            ;;
    esac
    shift
done

setup_virtualenv "$ROOT_DIR"

if [ "$QUIET" -eq 0 ]; then
    printf '%s\n' 'Environment setup complete.'
fi
