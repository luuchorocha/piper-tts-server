#!/bin/sh

show_script_help() {
    script_name=$1
    usage_suffix=$2
    description=$3

    printf '%s\n' "Usage: $script_name$usage_suffix"
    printf '%s\n' ''
    printf '%s\n' "$description"
    printf '%s\n' ''
    printf '%s\n' 'Options:'
    printf '%s\n' '  -h, --help  Show this help message and exit'
}

print_server_banner() {
    printf '%s\n' 'Server listening on http://127.0.0.1:5000'
    printf '%s\n' 'GET      /docs         Open interactive Swagger UI docs with Try it out'
    printf '%s\n' 'GET      /openapi.json OpenAPI schema for the HTTP API'
    printf '%s\n' 'GET|POST /             Synthesize text into WAV audio or alignment JSON'
    printf '%s\n' 'GET|POST /timestamps   Synthesize text and always return timestamp JSON'
    printf '%s\n' 'GET      /health       Report server readiness'
    printf '%s\n' 'GET      /voices       List voices available locally'
    printf '%s\n' 'GET      /all-voices   List the full remote voice catalog'
    printf '%s\n' 'GET      /playroom     Open the browser playground UI'
    printf '%s\n' 'GET|POST /download     Download a voice by id'
}